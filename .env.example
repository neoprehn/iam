# Vorlage — kopieren nach .env (gitignored, AE-01) und Passwort setzen.
# Neo4j verlangt mindestens 8 Zeichen.
NEO4J_PASSWORD=bitte-aendern-min-8-zeichen

# Sprach-Schalter für Text-Importe (sprachenindividuelle Tabellen: SPRAS/LANGU).
# Komma-getrennte Liste akzeptierter Sprachcodes; der erste Treffer gewinnt, sonst erster
# vorhandener Text. Deutsch deckt je nach Tabelle mehrere Schreibweisen ab (ISO-2 / ISO-3 /
# SAP-intern). Für Englisch z. B. EN,ENG,E. Leer lassen = Default DE,DEU,D.
IMPORT_LANG=DE,DEU,D
